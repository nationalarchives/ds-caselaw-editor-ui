{% extends "layouts/base.jinja" %}
{% from "components/badge.jinja" import badge %}
{% from "components/button.jinja" import button %}
{% from "components/field_display.jinja" import field_display %}
{% from "components/notification.jinja" import notification %}
{% from "components/navigation_tabs.jinja" import navigation_tabs, navigation_tab %}
{% from "components/toolbar.jinja" import toolbar, toolbar_section %}
{% from "components/document_metadata.jinja" import document_metadata %}
{% block aside %}
  {{ document_metadata(document=document) }}
{% endblock aside %}
{% block precontent %}
  {% if current_version_number %}
    {% call notification() %}
      <span>
        You are viewing <strong>version {{ current_version_number }}</strong> of this document.
      </span>
    {% endcall %}
  {% endif %}
  {% call navigation_tabs() %}
    {% set navigation_items = get_navigation_items() %}
    {% for item in navigation_items %}
      {{ navigation_tab(label=item.label, url=item.url, active=item.selected) }}
    {% endfor %}
  {% endcall %}
  {% call toolbar() %}
    {% call toolbar_section() %}
      {% call field_display(label="Submitter") %}
        {% if document.source_name and document.source_email %}
          <a href="mailto:{{ document.source_email }}">{{ document.source_name }}</a>
        {% else %}
          Unknown
        {% endif %}
      {% endcall %}
      {% call field_display(label="Status") %}
        {% set badge_variant = get_badge_variant_from_status(document.status) %}
        {% call badge(variant=badge_variant) %}
          {{ document.status }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    {% call toolbar_section() %}
      {% call button(size="small", href=jira_create_link, attrs={"target": "_blank", "rel":"noopener noreferrer"}) %}
        Create in Jira
      {% endcall %}
      <form action="{{ url('enrich') }}" method="post">
        {{ csrf_input }}
        <input type="hidden" name="document_uri" value="{{ document.uri }}" />
        {% call button(size="small", disabled=not user|is_editor_or_developer, disabled_reason=editors_or_developers_hint()) %}
          Request enrichment
        {% endcall %}
      </form>
      {% if waffle.flag("reparse") %}
        <form action="{{ url('reparse') }}" method="post">
          {{ csrf_input }}
          <input type="hidden" name="document_uri" value="{{ document.uri }}" />
          {% call button(size="small", disabled=not user|is_editor_or_developer, disabled_reason=editors_or_developers_hint()) %}
            Reparse
          {% endcall %}
        </form>
      {% endif %}
      {% call button(variant="danger", size="small", href=url("delete-document", document.uri), disabled=not user|can_edit) %}
        Delete
      {% endcall %}
    {% endcall %}
  {% endcall %}
  {% if document.is_locked %}
    {% call notification() %}
      <div class="container">
        <p>This document is locked: "{{ document.checkout_message }}"</p>
        <p>
          {% if user|is_editor_or_developer %}
            <a href="{{ url('unlock') }}?judgment_uri={{ document.uri }}">Unlock it</a>
          {% else %}
            {% call button(size="small", disabled=True, disabled_reason=editors_or_developers_hint()) %}
              Unlock it
            {% endcall %}
          {% endif %}
        </p>
      </div>
    {% endcall %}
  {% endif %}
{% endblock precontent %}
{% block breadcrumbs %}
  {% if document_type == "press_summary" %}
    <li>
      {% if linked_document_uri %}
        <a href="{{ url('full-text-html', linked_document_uri) }}">{{ page_title|get_title_to_display_in_html(document_type) }}</a>
      {% else %}
        <a>{{ page_title|get_title_to_display_in_html(document_type) }}</a>
      {% endif %}
    </li>
    <li>Press Summary</li>
  {% elif document_type == "judgment" %}
    <li>{{ "[Untitled Document]" if not page_title or page_title == "Untitled document" else page_title }}</li>
  {% elif page_title %}
    <li>{{ page_title }}</li>
  {% endif %}
{% endblock breadcrumbs %}
