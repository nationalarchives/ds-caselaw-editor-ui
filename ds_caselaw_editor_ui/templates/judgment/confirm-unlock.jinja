{% extends "layouts/base.jinja" %}
{% block content %}
  <div class="container edit-component">
    <div class="judgment-component__left-panel">
      <h2>Unlock {{ judgment_uri }}? This will make any enrichment processes on the document fail.</h2>
      <form method="post">
        {{ csrf_input }}
        <input type="hidden" name="judgment_uri" value="{{ judgment_uri }}" />
        {% set can_unlock = user|is_editor_or_developer %}
        <button class="button-cta"
                type="{{ 'submit' if can_unlock else 'button' }}"
                {% if not can_unlock %}aria-disabled="true" title="{{ editors_or_developers_hint() }}"{% endif %}>
          Unlock document
          {% if not can_unlock %}<span class="govuk-visually-hidden">({{ editors_or_developers_hint() }})</span>{% endif %}
        </button>
        <span class="judgment-component__back-button"><a href="{{ url('full-text-html', judgment_uri) }}">Back to document</a></span>
      </form>
    </div>
  </div>
{% endblock content %}
