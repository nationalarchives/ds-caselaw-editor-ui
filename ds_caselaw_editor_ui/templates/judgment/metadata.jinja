{% extends "layouts/judgment.jinja" %}
{% from "components/heading.jinja" import heading %}
{% from "components/notification.jinja" import notification %}
{% from "components/button.jinja" import button %}
{% from "components/document_metadata_claim_section.jinja" import metadata_claim_section %}
{% from "components/form_actions.jinja" import form_actions %}
{% block aside %}
{% endblock aside %}
{% block content %}
  <div class="container">
    {{ heading(content="Metadata for " ~ page_title) }}
    {% if document.metadata %}
      <form method="post">
        {{ csrf_input }}
        {% for section in metadata_claim_sections %}
          <section>
            {{ heading(tag="h3", content=section.metadata_item.title) }}
            {% if section.metadata_item.description %}
              <p class="muted">{{ section.metadata_item.description }}</p>
            {% endif %}
            <div class="card-list">{{ metadata_claim_section(section, variant="full", show_history=true) }}</div>
          </section>
        {% endfor %}
        {% call form_actions({"data-form-actions": ""} if user|can_edit else {}) %}
          {{ button(content="Update claims", disabled=not user|can_edit, attrs={"data-form-actions-submit": ""}) }}
          {{ button(content="Clear changes",
            variant="secondary",
            attrs={"type": "button", "data-form-actions-clear": ""}) }}
        {% endcall %}
      </form>
    {% else %}
      {% call notification() %}
        This document does not have any structured metadata.
      {% endcall %}
    {% endif %}
  </div>
{% endblock content %}
