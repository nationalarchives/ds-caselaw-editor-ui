{% extends "layouts/judgment.jinja" %}
{% from "components/heading.jinja" import heading %}
{% from "components/notification.jinja" import notification %}
{% from "components/badge.jinja" import badge %}
{% from "components/button.jinja" import button %}
{% from "components/text_input.jinja" import text_input %}
{% from "components/checkboxes.jinja" import checkboxes %}
{% from "components/card.jinja" import card %}
{% block aside %}
{% endblock aside %}
{% block content %}
  <div class="container">
    {{ heading(content="Metadata for " ~ document.body.name) }}
    {% if document.metadata %}
      <form method="post">
        {{ csrf_input }}
        {% for section in metadata_claim_sections %}
          <section>
            {{ heading(tag="h3", content=section.metadata_item.title) }}
            {% if section.metadata_item.description %}
              <p class="muted">{{ section.metadata_item.description }}</p>
            {% endif %}
            <div class="card-list">
              {% for display_claim in section.display_claims %}
                {% set card_right_content %}
                  {{ badge(variant=display_claim.status_badge_variant, content=display_claim.status) }}
                  {% if display_claim.can_reject %}
                    {{ checkboxes({
                                        "idPrefix": display_claim.reject_input_id_prefix,
                                        "name": display_claim.reject_input_name,
                                        "classes": "govuk-checkboxes--small",
                                        "items": [{
                                        "value": display_claim.reject_input_value,
                                        "text":"Mark as rejected"
                                        }]
                                        }) }}
                  {% endif %}
                {% endset %}
                {% call card(right_content=card_right_content, disabled=(True if not display_claim.is_current)) %}
                  <p>Value: {{ display_claim.display_value }}</p>
                  <p>Source: {{ display_claim.source_label }}</p>
                  {% if display_claim.timestamp %}
                    <p>Created: {{ display_claim.timestamp|date("%-d %b %Y %H:%M") }}</p>
                  {% endif %}
                  {% if display_claim.claim_id and user|is_developer %}
                    <p>
                      Claim id: <code>{{ display_claim.claim_id }}</code>
                    </p>
                  {% endif %}
                {% endcall %}
              {% endfor %}
              {% call card() %}
                {{ text_input({
                                "label": "New claim",
                                "id_for_label": section.new_claim_input_id,
                                "html_name": section.new_claim_input_name,
                                "value": ""
                                }) }}
              {% endcall %}
            </div>
          </section>
        {% endfor %}
        <p>{{ button(content="Update claims") }}</p>
      </form>
    {% else %}
      {% call notification() %}
        This document does not have any structured metadata.
      {% endcall %}
    {% endif %}
  </div>
{% endblock content %}
