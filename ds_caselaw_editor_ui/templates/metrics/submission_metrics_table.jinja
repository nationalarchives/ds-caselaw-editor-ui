{% from "components/heading.jinja" import heading %}
{% macro submission_metric_row(row) %}
  <tr>
    <td title="{{ row.period_raw }}">{{ row.period }}</td>
    <td>{{ row.count|intcomma }}</td>
    <td>{{ row.total|intcomma }}</td>
    <td>
      {% if row.median is not none %}
        <span title="{{ row.median.raw }}">{{ row.median.display }}</span>
      {% else %}
        No data
      {% endif %}
    </td>
    <td>
      {% if row.mean is not none %}
        <span title="{{ row.mean.raw }}">{{ row.mean.display }}</span>
      {% else %}
        No data
      {% endif %}
    </td>
  </tr>
{% endmacro %}
{% macro submission_metrics_table(metrics=None) %}
  <section>
    {{ heading(tag="h2", content=metrics.label) }}
    <div class="table">
      <table>
        <thead>
          <tr>
            <th>Period</th>
            <th>Documents measured</th>
            <th>Total submissions</th>
            <th>Median submissions</th>
            <th>Mean submissions</th>
          </tr>
        </thead>
        <tbody>
          {% for row in metrics.rows %}
            {{ submission_metric_row(row) }}
          {% else %}
            <tr>
              <td colspan="5">No metrics available for this period.</td>
            </tr>
          {% endfor %}
        </tbody>
        {% if metrics.total_row %}<tfoot>{{ submission_metric_row(metrics.total_row) }}</tfoot>{% endif %}
      </table>
    </div>
  </section>
{% endmacro %}
