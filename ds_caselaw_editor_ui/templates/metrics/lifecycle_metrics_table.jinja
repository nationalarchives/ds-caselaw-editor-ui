{% from "components/heading.jinja" import heading %}
{% macro lifecycle_metrics_table(metrics=None) %}
  <section>
    {{ heading(tag="h2", content=metrics.label) }}
    <div class="table">
      <table>
        <thead>
          <tr>
            <th>Period</th>
            <th>Documents measured</th>
            {% if metrics.show_within_24_hours_percentage %}
              <th>First publication within 24 hours</th>
            {% endif %}
            <th>Median time</th>
            <th>Mean time</th>
          </tr>
        </thead>
        <tbody>
          {% for row in metrics.rows %}
            <tr>
              <td title="{{ row.period_raw }}">{{ row.period }}</td>
              <td>{{ row.count|intcomma }}</td>
              {% if metrics.show_within_24_hours_percentage %}
                <td>
                  {% if row.within_24_hours_percentage is not none %}
                    <span title="{{ row.within_24_hours_percentage.numerator|intcomma }} of {{ row.within_24_hours_percentage.denominator|intcomma }} journeys">
                      {{ row.within_24_hours_percentage.display }}
                    </span>
                  {% else %}
                    No data
                  {% endif %}
                </td>
              {% endif %}
              <td>
                {% if row.median is not none %}
                  <span title="{{ row.median.raw }} seconds">{{ row.median.display }}</span>
                {% else %}
                  No data
                {% endif %}
              </td>
              <td>
                {% if row.mean is not none %}
                  <span title="{{ row.mean.raw }} seconds">{{ row.mean.display }}</span>
                {% else %}
                  No data
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="{{ 5 if metrics.show_within_24_hours_percentage else 4 }}">No metrics available for this period.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endmacro %}
