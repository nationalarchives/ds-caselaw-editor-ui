{% extends "metrics/base.jinja" %}
{% from "metrics/summary.jinja" import metrics_summary %}
{% from "metrics/publication_counts_table.jinja" import publication_counts_table %}
{% from "metrics/lifecycle_metrics_table.jinja" import lifecycle_metrics_table %}
{% block metrics_content %}
  {{ metrics_summary(metrics=summary_metrics) }}
  {{ publication_counts_table(metrics=publication_counts) }}
  {% if first_publication_metrics %}
    {{ lifecycle_metrics_table(metrics=first_publication_metrics) }}
  {% endif %}
{% endblock metrics_content %}
