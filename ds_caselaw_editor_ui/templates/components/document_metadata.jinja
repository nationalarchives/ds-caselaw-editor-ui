{% from "components/icon.jinja" import icon %}
{% from "components/button.jinja" import button %}
{% from "components/badge.jinja" import badge %}
{% from "components/details.jinja" import details %}
{% from "govuk_frontend_jinja/components/date-input/macro.html" import govukDateInput %}
{% from "govuk_frontend_jinja/components/input/macro.html" import govukInput %}
{% from "components/document_metadata_item.jinja" import document_metadata_item %}
{% from "components/document_metadata_claim_section.jinja" import metadata_claim_section with context %}
{% from "components/form_actions.jinja" import form_actions %}
{% macro document_metadata(document=None) %}
  {% set metadata = document.metadata if document.metadata is defined else {} %}
  {% set identifiers = document.identifiers if document.identifiers is defined else none %}
  {% set preferred_identifier = identifiers.preferred() if identifiers else none %}
  {% set judgment_date = metadata.date.value %}
  {% if document.body is defined %}
    {% set court_value = document.body.court_and_jurisdiction_identifier_string %}
  {% else %}
    {% set court_value = metadata.court.value %}
  {% endif %}
  {% set can_edit_document = user is defined and user|can_edit %}
  <div class="aside__container" data-aside-toggle>
    <button type="button" class="aside__toggle" data-aside-toggle-button>
      <span class="icon icon__chevron-left"></span>
      <span>Metadata</span>
    </button>
    <div class="aside__content">
      <div class="aside__title">
        <span>Metadata</span>
        {{ button(variant="link", size="small", content="Hide panel", attrs={"data-aside-toggle-button":""}) }}
      </div>
      <form aria-label="Edit judgment"
            id="document-edit-form"
            method="post"
            action="{{ url('edit-document', document.uri) }}"
            data-document-edit-form
            {% if metadata_judges_section is defined and metadata_judges_section and can_edit_document %} data-metadata-compact-form data-new-claim-input-name="{{ metadata_judges_section.new_claim_input_name }}" {% endif %}>
        {{ csrf_input }}
        <input type="hidden" name="return_to" value="html" />
        <input type="hidden" name="judgment_uri" value="{{ document.uri }}" />
        <div class="aside__form-content">
          {% call details(title="Editable metadata", variant="panel", open=True) %}
            <dl>
              <div>
                <dt>Title</dt>
                <dd>
                  {{ govukInput({
                    "label": { "text": "Title", "classes": "govuk-visually-hidden" },
                    "id": "metadata_name",
                    "name": "metadata_name",
                    "value": metadata.title.value,
                  }) }}
                </dd>
              </div>
              <div>
                <dt>NCN</dt>
                <dd>
                  {{ govukInput({
                    "label": { "text": "NCN", "classes": "govuk-visually-hidden" },
                    "id": "neutral_citation",
                    "name": "neutral_citation",
                    "value": preferred_ncn.value if preferred_ncn else "",
                  }) }}
                </dd>
              </div>
              <div>
                <dt>Court</dt>
                <dd>
                  <datalist id="court-list">
                    {% for court in courts|default([]) %}
                      {% if court.code %}<option value="{{ court.code }}">{{ court.name }}</option>{% endif %}
                    {% endfor %}
                  </datalist>
                  {{ govukInput({
                    "label": { "text": "Court", "classes": "govuk-visually-hidden" },
                    "id": "court",
                    "name": "court",
                    "value": court_value,
                    "attributes": { "list": "court-list" },
                  }) }}
                </dd>
              </div>
              <div>
                <dt>Judgment date</dt>
                <dd>
                  {{ govukDateInput({
                    "id": "judgment_date",
                    "namePrefix": "judgment_date",
                    "fieldset": {
                      "legend": { "text": "Judgment date", "classes": "govuk-visually-hidden" }
                    },
                    "items": [
                      {
                        "name": "day",
                        "value": judgment_date.day|string if judgment_date else "",
                        "classes": "govuk-input--width-2"
                      },
                      {
                        "name": "month",
                        "value": judgment_date.month|string if judgment_date else "",
                        "classes": "govuk-input--width-2"
                      },
                      {
                        "name": "year",
                        "value": judgment_date.year|string if judgment_date else "",
                        "classes": "govuk-input--width-4"
                      }
                    ]
                  }) }}
                </dd>
              </div>
              <div>
                <dt>Judges</dt>
                <dd>
                  {% if metadata_judges_section is defined and metadata_judges_section and can_edit_document %}
                    {{ metadata_claim_section(metadata_judges_section, variant="compact", show_history=false) }}
                  {% else %}
                    {{ document_metadata_item(metadata_item=metadata.judges) }}
                  {% endif %}
                </dd>
              </div>
            </dl>
          {% endcall %}
          {% call details(title="Identifiers", variant="panel") %}
            <dl>
              <div>
                <dt>Case number</dt>
                <dd>
                  {{ document_metadata_item(metadata_item=metadata.case_number) }}
                </dd>
              </div>
              <div>
                <dt>Other</dt>
                <dd>
                  {% set identifier_list = identifiers.by_score() if identifiers else [] %}
                  {% set preferred_uuid = preferred_identifier.uuid if preferred_identifier else none %}
                  {% set other = namespace(shown=false) %}
                  {% for identifier in identifier_list %}
                    {% if identifier.uuid != preferred_uuid %}
                      {{ badge(content=identifier.schema.name ~ ": " ~ identifier.value) }}
                      {% set other.shown = true %}
                    {% endif %}
                  {% endfor %}
                  {% if not other.shown %}
                    {{ None|or_no_data_available_label }}
                  {% endif %}
                </dd>
              </div>
            </dl>
          {% endcall %}
          {% call details(title="Other metadata", variant="panel") %}
            <dl>
              <div>
                <dt>Jurisdiction</dt>
                <dd>
                  {{ document_metadata_item(metadata_item=metadata.jurisdiction) }}
                </dd>
              </div>
              <div>
                <dt>TDR ref</dt>
                <dd>
                  {{ document.consignment_reference|or_no_data_available_label }}
                </dd>
              </div>
              <div>
                <dt>Type</dt>
                <dd>
                  {{ document.document_noun|title }}
                </dd>
              </div>
              <div>
                <dt>First pub</dt>
                <dd>
                  {% if document.has_ever_been_published %}
                    {% if document.first_published_datetime_display %}
                      {{ document.first_published_datetime_display | date("%-d %b %Y %H:%M") }}
                    {% else %}
                      Unknown
                    {% endif %}
                  {% else %}
                    {{ None|or_no_data_available_label }}
                  {% endif %}
                </dd>
              </div>
              <div>
                <dt>Source name</dt>
                <dd>
                  {{ document.source_name|or_no_data_available_label }}
                </dd>
              </div>
              <div>
                <dt>Source email</dt>
                <dd>
                  {{ document.source_email|or_no_data_available_label }}
                </dd>
              </div>
              <div>
                <dt>Parties</dt>
                <dd>
                  {{ None|or_no_data_available_label }}
                </dd>
              </div>
              <div>
                <dt>Categories</dt>
                <dd>
                  {{ document_metadata_item(metadata_item=metadata.categories) }}
                </dd>
              </div>
            </dl>
          {% endcall %}
        </div>
        {% call form_actions({"data-form-actions": ""}) %}
          {{ button(content="Save",
            disabled=not can_edit_document,
            size="small",
            attrs={"type": "submit", "data-form-actions-submit": ""}) }}
          {{ button(content="Clear changes",
            variant="secondary",
            disabled=not can_edit_document,
            size="small",
            attrs={"type": "button", "data-form-actions-clear": ""}) }}
        {% endcall %}
      </form>
    </div>
  </div>
{% endmacro %}
