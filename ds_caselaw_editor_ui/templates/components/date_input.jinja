{% from "govuk_frontend_jinja/components/date-input/macro.html" import govukDateInput %}
{% macro govuk_date_input(field) %}
  {% set value = field.value if field is mapping else none %}
  {% set day = value.day|string if value else "" %}
  {% set month = value.month|string if value else "" %}
  {% set year = value.year|string if value else "" %}
  {% set label_classes = {"default": "govuk-fieldset__legend--s", "extra-small": "govuk-fieldset__legend--xs"} %}
  {% set legend_class = label_classes.get(field.label_size, label_classes["default"]) %}
  {% set form_group_classes = field.form_group_classes if field.form_group_classes is defined else "" %}
  {% if field.margin == "small" %}
    {% set form_group_classes = form_group_classes ~ " govuk-!-margin-bottom-4" %}
  {% endif %}
  {% set form_group_classes = form_group_classes.strip() %}
  {{ govukDateInput({
    "id": field.id_for_label,
    "namePrefix": field.html_name,
    "formGroup": { "classes": form_group_classes } if form_group_classes else None,
    "fieldset": {
      "legend": { "text": field.label, "classes": legend_class }
    },
    "hint": { "text": field.help_text } if field.help_text else None,
    "items": [
      { "name": "day", "value": day, "classes": "govuk-input--width-2" },
      { "name": "month", "value": month, "classes": "govuk-input--width-2" },
      { "name": "year", "value": year, "classes": "govuk-input--width-4" }
    ]
  }) }}
{% endmacro %}
{% macro date_input(field) %}
  {% set errors = {"text": field.errors | join(", ")} if field.errors else None %}
  {% set inputClass = "govuk-input--width-2 govuk-input--error" if field.errors else "govuk-input--width-2" %}
  {% set parts = field.field.widget.decompress(field.value()) %}
  {% set day = parts[0] or "" %}
  {% set month = parts[1] or "" %}
  {% set year = parts[2] or "" %}
  {{ govukDateInput({
    "id":        field.id_for_label,
    "namePrefix": field.html_name,
    "fieldset": {
      "legend": { "text": field.label, "classes": "govuk-fieldset__legend--s" }
    },
    "hint":         { "text": field.help_text } if field.help_text else None,
    "items": [
      { "name": "day",   "value": day,   "classes": inputClass },
      { "name": "month", "value": month, "classes": inputClass },
      { "name": "year",  "value": year,  "classes": "govuk-input--width-4" ~ (" govuk-input--error" if field.errors else "") }
    ],
    "errorMessage": errors
  }) }}
{% endmacro %}
