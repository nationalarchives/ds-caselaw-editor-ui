{% from "components/metadata.jinja" import metadata_container, metadata_body, metadata_body_row, metadata_aside %}
{% from "components/panel.jinja" import panel %}
{% from "components/date_input.jinja" import govuk_date_input_grid %}
{% from "components/metadata_form_grid.jinja" import metadata_grid_text_input, metadata_grid_datalist_input, metadata_grid_textarea %}
{% from "components/button.jinja" import button %}
{% macro document_form() %}
  {% call panel() %}
    <form aria-label="Edit judgment"
          method="post"
          action="{{ url('edit-document', judgment.uri) }}">
      {{ csrf_input }}
      <input type="hidden" name="return_to" value="html" />
      <input type="hidden" name="judgment_uri" value="{{ document_uri }}" />
      {% call metadata_container() %}
        {% call metadata_body() %}
          {% call metadata_body_row(variant="edit-primary-fields") %}
            {{ metadata_grid_text_input("ncn", "NCN", "neutral_citation", "neutral_citation", preferred_ncn.value) }}
            {% set court_options = [] %}
            {% for court in courts %}
              {% set _ = court_options.append((court.code, court.name)) %}
            {% endfor %}
            {{ metadata_grid_datalist_input("court", "Court", "court", "court", document.body.court_and_jurisdiction_identifier_string, court_options) }}
            {{ govuk_date_input_grid({
              "label": "Judgment date",
              "id_for_label": "judgment_date",
              "html_name": "judgment_date",
              "value": document.metadata.date.value,
            }) }}
          {% endcall %}
          {% call metadata_body_row(variant="edit-title-field") %}
            {{ metadata_grid_textarea("title", "Title", "metadata_name", "metadata_name", document.metadata.title.value, 2) }}
          {% endcall %}
          {% call metadata_body_row() %}
            {% call button(disabled=not user|can_edit) %}
              Save
            {% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    </form>
  {% endcall %}
{% endmacro %}
