{% from "components/metadata.jinja" import metadata_container, metadata_body, metadata_body_row, metadata_aside %}
{% from "components/panel.jinja" import panel %}
{% from "components/text_input.jinja" import text_input %}
{% from "components/date_input.jinja" import govuk_date_input %}
{% from "components/textarea.jinja" import textarea %}
{% from "components/datalist_input.jinja" import datalist_input %}
{% from "components/field_display.jinja" import field_display %}
{% from "components/button.jinja" import button %}
{% macro document_form() %}
  {% call panel() %}
    <form aria-label="Edit judgment"
          method="post"
          action="{{ url('edit-document', judgment.uri) }}">
      {{ csrf_input }}
      <input type="hidden" name="return_to" value="html" />
      <input type="hidden" name="judgment_uri" value="{{ document_uri }}" />
      {% call metadata_container() %}
        {% call metadata_body() %}
          {% call metadata_body_row(variant="edit-primary-fields") %}
            {{ text_input({"label": "NCN", "id_for_label": "neutral_citation", "html_name": "neutral_citation", "value": preferred_ncn.value, "margin": "small"}) }}
            {% set court_options = [] %}
            {% for court in courts %}
              {% set _ = court_options.append((court.code, court.name)) %}
            {% endfor %}
            {{ datalist_input({"label": "Court", "id_for_label": "court", "html_name": "court", "choices": court_options, "value": document.body.court_and_jurisdiction_identifier_string, "margin": "small" }) }}
            {{ govuk_date_input({
              "label": "Judgment date",
              "id_for_label": "judgment_date",
              "html_name": "judgment_date",
              "value": document.metadata.date.value,
              "margin": "small",
              "form_group_classes": "metadata__date-field",
            }) }}
          {% endcall %}
          {% call metadata_body_row() %}
            {{ textarea({"label": "Title", "id_for_label": "metadata_name", "html_name": "metadata_name", "value": document.metadata.title.value, "rows": 2, "width": "full", "margin": "small"}) }}
          {% endcall %}
          {% call metadata_body_row() %}
            {% call button(disabled=not user|can_edit) %}
              Save
            {% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    </form>
  {% endcall %}
{% endmacro %}
