{% from "components/badge.jinja" import badge %}
{% from "components/button.jinja" import button %}
{% from "components/checkboxes.jinja" import checkboxes %}
{% from "components/card.jinja" import card %}
{% from "components/metadata_form_widgets.jinja" import metadata_new_claim_input %}
{% macro aside_metadata_compact_entry(display_value, remove_input=none) %}
  <div class="aside__metadata-compact-entry">
    <span class="aside__metadata-compact-entry__name">{{ display_value }}</span>
    {% if remove_input %}
      <div class="aside__metadata-compact-entry__remove">
        <input class="govuk-visually-hidden aside__metadata-compact-remove-input"
               id="{{ remove_input.id }}"
               type="checkbox"
               {% if remove_input.name %}name="{{ remove_input.name }}"{% endif %}
               {% if remove_input.disabled %}disabled{% endif %}
               value="{{ remove_input.value }}" />
        <label class="button button--link button--small aside__metadata-compact-remove-label"
               for="{{ remove_input.id }}"
               {% if remove_input.disabled %}aria-disabled="true" title="At least one judge is required"{% endif %}>
          Remove<span class="govuk-visually-hidden" data-metadata-compact-remove-name> {{ display_value }}</span>
        </label>
      </div>
    {% endif %}
  </div>
{% endmacro %}
{% macro aside_metadata_compact_new_entry(input_id, required=false, initial=false) %}
  <div class="aside__metadata-compact-entry"
       data-metadata-compact-new-entry
       {% if initial %}data-metadata-compact-initial-new-entry{% endif %}>
    <textarea class="govuk-textarea govuk-!-width-full aside__metadata-compact-new-input"
              id="{{ input_id }}"
              type="text"
              autocomplete="off"
              aria-label="New judge name"
              data-metadata-compact-new-input
              {% if required %}required{% endif %}></textarea>
    {{ button(content="Remove",
      variant="link",
      size="small",
      attrs={"type": "button", "data-metadata-compact-remove-new": ""}) }}
  </div>
{% endmacro %}
{% macro metadata_claim_section(section, variant="full", show_history=true) %}
  {% set claims = section.display_claims if show_history else section.current_display_claims %}
  {% if variant == "compact" %}
    <div class="aside__metadata-compact-list" data-metadata-compact-list>
      {% for display_claim in claims %}
        {{ aside_metadata_compact_entry(
          display_claim.display_value,
          remove_input={
            "id": display_claim.reject_input_id_prefix,
            "name": display_claim.reject_input_name,
            "value": display_claim.reject_input_value,
            "disabled": claims|length == 1
          } if display_claim.can_reject else none
        ) }}
      {% endfor %}
      {% if not claims %}
        {{ aside_metadata_compact_new_entry(
          section.new_claim_input_id ~ "-0",
          required=true,
          initial=true
        ) }}
      {% endif %}
      <template data-metadata-compact-new-template>
        {{ aside_metadata_compact_new_entry(section.new_claim_input_id ~ "-__INDEX__") }}
      </template>
      <div class="aside__metadata-compact-add-row" data-metadata-compact-add-row>
        {{ button(content="Add another judge",
          variant="link",
          size="small",
          attrs={"type": "button", "data-metadata-compact-add": ""}) }}
      </div>
    </div>
  {% else %}
    {% for display_claim in claims %}
      {% set card_right_content %}
        {{ badge(variant=display_claim.status_badge_variant, content=display_claim.status) }}
        {% if display_claim.can_reject %}
          {{ checkboxes({
            "idPrefix": display_claim.reject_input_id_prefix,
            "name": display_claim.reject_input_name,
            "classes": "govuk-checkboxes--small",
            "items": [{
              "value": display_claim.reject_input_value,
              "text": display_claim.reject_checkbox_text
            }]
          }) }}
        {% endif %}
      {% endset %}
      {% call card(right_content=card_right_content, disabled=(not display_claim.is_current)) %}
        <p>Value: {{ display_claim.display_value }}</p>
        <p>Source: {{ display_claim.source_label }}</p>
        {% if display_claim.timestamp %}
          <p>Created: {{ display_claim.timestamp|date("%-d %b %Y %H:%M") }}</p>
        {% endif %}
        {% if display_claim.claim_id and user|is_developer %}
          <p>
            Claim id: <code>{{ display_claim.claim_id }}</code>
          </p>
        {% endif %}
      {% endcall %}
    {% endfor %}
    {% call card() %}
      {{ metadata_new_claim_input(section) }}
    {% endcall %}
  {% endif %}
{% endmacro %}
