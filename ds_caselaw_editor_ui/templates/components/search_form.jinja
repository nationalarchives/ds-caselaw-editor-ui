{% macro search_form(embedded=false, form_action=None, clear_href=None, heading="Search for documents") %}
  {% if form_action is none %}
    {% set form_action = url('results') %}
  {% endif %}
  <div class="search-component">
    <div class="search-component__container">
      {% if embedded %}
        <div role="search"
             aria-label="Search by keyword or neutral citation"
             id="analytics-basic-search">{{ _search_form_fields(clear_href=clear_href, heading=heading) }}</div>
      {% else %}
        <form action="{{ form_action }}"
              role="search"
              aria-label="Search by keyword or neutral citation"
              id="analytics-basic-search">
          {{ _search_form_fields(clear_href=clear_href, heading=heading) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endmacro %}
{% macro _search_form_fields(clear_href=None, heading="Search for documents") %}
  {% if clear_href is none %}
    {% if document_list_queue_enabled %}
      {% set clear_href = url('home') ~ '?' ~ clear_search_query_string %}
    {% else %}
      {% set clear_href = "" %}
    {% endif %}
  {% endif %}
  <h2>{{ heading }}</h2>
  <div class="search-component__filters govuk-radios govuk-radios--small">
    <div class="search-component__filter govuk-radios__item">
      <input class="govuk-radios__input"
             type="radio"
             id="search-default"
             name="search_filter"
             value="default"
             {% if search_filter == "default" or not search_filter %}checked{% endif %} />
      <label class="govuk-label govuk-radios__label" for="search-default">Everywhere</label>
    </div>
    <div class="search-component__filter govuk-radios__item">
      <input class="govuk-radios__input"
             type="radio"
             id="search-ncn"
             name="search_filter"
             value="ncn"
             {% if search_filter == "ncn" %}checked{% endif %} />
      <label class="govuk-label govuk-radios__label" for="search-ncn">NCN</label>
    </div>
  </div>
  <div class="search-component__search-input">
    <input class="search-component__search-term-input"
           id="search_term"
           name="query"
           type="search"
           value="{{ query or "" }}" />
    {% if document_list_queue_enabled %}
      <button type="submit" class="button">Search</button>
    {% else %}
      <input type="submit" value="Search" />
    {% endif %}
    <a href="{{ clear_href }}">Clear search</a>
  </div>
{% endmacro %}
